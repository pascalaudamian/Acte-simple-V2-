# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string for durable persistence of audit logs and feedback.
# Format: postgres://username:password@hostname:5432/database_name
# When unconfigured or unreachable, the system automatically falls back to local durable JSON journaling.
DATABASE_URL="postgres://postgres:password@localhost:5432/actesimple_db"
DATABASE_SSL="true"

# ACTESIMPLE_EDITOR_TOKEN: Server-side secret token required for privileged editorial operations
# (POST /api/v1/sources/:id/check, GET /api/v1/editorial/*). Never commit or expose to client.
ACTESIMPLE_EDITOR_TOKEN="GENERATE_A_SECURE_64_CHAR_HEX_TOKEN"
